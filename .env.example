# Supabase Configuration
# Set these to your Supabase project URL and keys for cloud/self-hosted Supabase.
# When left as placeholder values in local dev, CardFlow automatically uses its built-in
# Supabase-compatible local database + signed-URL private storage engine with full RLS enforcement.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Python OCR & Backend Service Configuration
NEXT_PUBLIC_OCR_API_URL=http://127.0.0.1:8000
OCR_SERVICE_URL=http://127.0.0.1:8000
OCR_INTERNAL_SHARED_SECRET=cardflow-internal-service-secret-change-in-prod

# OCR & Batch Processing Tuning
MAX_BATCH_SIZE=50
MAX_FILE_SIZE_MB=10
MAX_CONCURRENT_OCR_WORKERS=3
OCR_LANGUAGE=en
SIGNED_URL_TTL_SECONDS=3600

# Optional Redis Queue URL (falls back to persistent SQLite/PostgreSQL job queue when omitted)
REDIS_URL=

